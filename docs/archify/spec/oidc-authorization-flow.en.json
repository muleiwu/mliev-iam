  "cards": [
    {
      "dot": "cyan",
      "title": "Authorization & Login",
      "items": [
        "Authorization code flow with PKCE; state prevents CSRF and the session binds to the browser",
        "Redis sessions: oidc:session: prefix · 10-min TTL · rotating CSRF"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tokens & Endpoints",
      "items": [
        "POST /token exchanges code + code_verifier; id_token is RS256-signed",
        "introspect / revoke / jwks / discovery cover token lifecycle and auto-discovery"
      ]
    }
