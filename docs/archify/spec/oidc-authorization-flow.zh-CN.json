    {
      "id": "mysql",
      "type": "database",
      "label": "MySQL",
      "sublabel": "用户 · 应用 · 授权码"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 458,
      "label": "授权引导 · 登录 · 同意"
    },
    {
      "from": 466,
      "to": 550,
      "label": "令牌颁发"
    },
    {
      "from": 558,
      "to": 628,
      "label": "资源访问"
    }
  ],
  "messages": [
    {
      "id": "redirect-authorize",
      "from": "client-app",
      "to": "browser",
      "y": 172,
      "label": "重定向 authorize（state · PKCE）",
      "variant": "emphasis"
    },
    {
      "id": "get-authorize",
      "from": "browser",
      "to": "iam",
      "y": 201,
      "label": "GET /oidc/:client_id/authorize"
    },
    {
      "id": "to-login",
      "from": "iam",
      "to": "browser",
      "y": 230,
      "label": "302 → /auth 登录页",
      "variant": "return"
    },
    {
      "id": "submit-login",
      "from": "auth-ui",
      "to": "iam",
      "y": 259,
      "label": "POST /api/oidc 登录"
    },
    {
      "id": "create-session",
      "from": "iam",
      "to": "redis",
      "y": 288,
      "label": "写入 oidc:session:（TTL 10min）"
    },
    {
      "id": "login-ok",
      "from": "iam",
      "to": "auth-ui",
      "y": 317,
      "label": "登录成功 → consent 页",
      "variant": "return"
    },
    {
      "id": "confirm-consent",
      "from": "auth-ui",
      "to": "iam",
      "y": 346,
      "label": "确认授权（consent · CSRF）"
    },
    {
      "id": "issue-code",
      "from": "iam",
      "to": "mysql",
      "y": 375,
      "label": "校验用户 · 生成授权码"
    },
    {
      "id": "redirect-back",
      "from": "iam",
      "to": "browser",
      "y": 404,
      "label": "302 redirect_uri?code&state",
      "variant": "return"
    },
    {
      "id": "callback",
      "from": "browser",
      "to": "client-app",
      "y": 433,
      "label": "回跳携带 code + state"
    },
    {
      "id": "token-request",
      "from": "client-app",
      "to": "iam",
      "y": 476,
      "label": "POST /token（code · verifier）",
      "variant": "emphasis"
    },
    {
      "id": "exchange-code",
      "from": "iam",
      "to": "mysql",
      "y": 505,
      "label": "校验会话 · 换取授权码"
    },
    {
      "id": "token-response",
      "from": "iam",
      "to": "client-app",
      "y": 534,
      "label": "access_token · id_token · refresh_token",
      "variant": "return"
    },
    {
      "id": "userinfo-request",
      "from": "client-app",
      "to": "iam",
      "y": 577,
      "label": "GET /userinfo（Bearer）"
    },
    {
      "id": "userinfo-response",
      "from": "iam",
      "to": "client-app",
      "y": 606,
      "label": "用户 claims",
      "variant": "return"
    }
