  "cards": [
    {
      "dot": "cyan",
      "title": "Frontends & Serving",
      "items": [
        "web-antd console → static/admin → /admin; frontend-oidc → static/auth → /auth",
        "Embedded via go:embed in release; disk hot-reload in debug mode",
        "go-web global middleware: traceId → access log → Recovery → CORS → install gate"
      ]
    },
    {
      "dot": "violet",
      "title": "Protocols & Data",
      "items": [
        "Protocol factory supports OIDC · SAML · CAS · OAuth2 with directory-sync and social adapters",
        "MySQL by default (PostgreSQL/SQLite optional); goose versioned migrations run at startup",
        "Redis holds OIDC sessions and cache; S3-compatible storage for attachments"
      ]
    }
