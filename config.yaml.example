# 系统配置
app:
  installed: false  # 系统是否已安装

# 服务器配置
server:
  mode: release  # debug, release, test
  addr: ":8080"

# 数据库配置
database:
  driver: mysql  # 数据库驱动类型: mysql, postgresql, sqlite
  halt_on_migration_failure: true
  # MySQL / PostgreSQL 配置
  host: localhost
  port: 3306
  username: root
  password: password
  database: dwz_db
  charset: utf8mb4  # 仅 MySQL 使用
  parse_time: true
  loc: Local
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600
  # SQLite 配置（仅在 driver 为 sqlite 时使用）
  filepath: ""  # SQLite 数据库文件路径，例如: ./config/mliev_iam.db

# PostgreSQL 配置（可选）
# postgres:
#   host: localhost
#   port: 5432
#   username: postgres
#   password: password
#   database: dwz_db
#   sslmode: disable

# Redis 配置
redis:
  host: localhost
  port: 6379
  password: ""
  db: 0
  pool_size: 10
  min_idle_conns: 5

# 日志配置
log:
  level: info    # debug, info, warn, error
  filename: logs/app.log
  max_size: 100     # MB
  max_age: 30       # days
  max_backups: 10
  compress: true

# JWT 配置
jwt:
  secret: your-secret-key
  expire_hours: 24

# 短链接配置
shortlink:
  domain: "http://localhost:8080"
  length: 6
  custom_length: true

# 限流配置
rate_limit:
  requests_per_minute: 100
  burst: 10

# CORS 配置
cors:
  allow_origins:
    - "*"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Origin"
    - "Content-Type"
    - "Authorization"

# OIDC 配置
oidc:
  # 颁发者标识符（通常是服务的基础URL）
  # 注意：在反向代理（如Nginx）环境下，建议配置实际的外部访问地址
  # 系统会优先使用 X-Forwarded-Proto 和 X-Forwarded-Host 头部，
  # 如果没有这些头部，则使用此配置项
  # 示例：
  # - 开发环境: "http://localhost:8080"
  # - 生产环境: "https://auth.example.com"
  issuer: "http://localhost:8080"
  
  # 注意：签名密钥配置已移除
  # 每个 OIDC 应用在创建时会自动生成独立的签名密钥（默认 RS256, 2048位）
  # 密钥存储在数据库中，支持密钥轮转和多种算法（RS256, RS512, HS256等）
  # 无需手动配置密钥文件
  
  # 默认令牌生命周期（秒）
  token_lifetime:
    # 访问令牌过期时间
    access_token: 3600     # 1小时
    # 刷新令牌过期时间
    refresh_token: 2592000 # 30天
    # ID令牌过期时间
    id_token: 3600         # 1小时
    # 授权码过期时间
    authorization_code: 600 # 10分钟
  
  # 支持的功能配置
  features:
    # 是否启用PKCE支持
    pkce_enabled: true
    # 是否启用令牌内省端点
    introspection_enabled: true
    # 是否启用令牌撤销端点
    revocation_enabled: true
    # 是否启用刷新令牌
    refresh_token_enabled: true
  
  # 客户端默认配置
  defaults:
    # 默认作用域
    scopes: ["openid", "profile", "email"]
    # 默认授权类型
    grant_types: ["authorization_code", "refresh_token"]
    # 默认响应类型
    response_types: ["code"]
    # 默认客户端类型
    client_type: "confidential"
  
  # 会话配置
  session:
    # Redis key前缀
    redis_key_prefix: "oidc:session:"
    # 会话过期时间（秒）
    expiration: 600  # 10分钟
  
  # 安全配置
  security:
    # 授权码最大尝试次数
    max_authorization_attempts: 5
    # 客户端最大失败尝试次数
    max_client_failure_attempts: 10
    # 令牌最大刷新次数
    max_token_refresh_attempts: 100
    # 是否启用速率限制
    rate_limit_enabled: true 